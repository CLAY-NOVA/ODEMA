    <!-- About -->
    <string name="about_title">About Odema</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_how">Odema asks up to 15 forecast sources about each of your places every few minutes and alerts you only when enough of them agree. Ensembles (dozens of runs of the same model) turn that into a real probability.</string>
    <string name="about_data">Data sources</string>
    <string name="about_text">Open-Meteo (CC BY 4.0) with models from ECMWF, Météo-France, DWD, UK Met Office, NOAA, Environment Canada, JMA and CMA; MET Norway (CC BY 4.0); DWD MOSMIX station forecasts via Bright Sky; place names from GeoNames; maps © OpenStreetMap contributors.</string>
    <string name="about_official">Official warnings</string>
    <string name="about_disclaimer">Odema is a personal tool, not an official warning service. For severe weather, follow the Direction Générale de la Météorologie (DGM) and the authorities.</string>
    <string name="about_reliability">If alerts arrive late</string>
    <string name="about_reliability_text">Some phones (Xiaomi, Huawei, Oppo, Samsung…) stop background apps aggressively. Allow background checks in Settings, keep the app in your recent apps, and see dontkillmyapp.com for your phone model.</string>

